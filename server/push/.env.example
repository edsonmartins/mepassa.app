# PostgreSQL Database
DATABASE_URL=postgresql://zaplivre:zaplivre_dev_password@localhost:5432/zaplivre

# Port HTTP do servidor
PORT=8081

# Secret compartilhado com o message-store (mín. 32 caracteres).
# Usado no Bearer token das chamadas de serviço (ex.: /api/stats).
PUSH_SERVICE_SECRET=change_me_to_a_random_32_character_secret

# Concorrência máxima de envio (opcional)
PUSH_MAX_CONCURRENT=128

# FCM HTTP v1: JSON do service account (caminho no container).
# A legacy API (FCM_SERVER_KEY) foi desligada pelo Google (PSH-01).
FCM_SERVICE_ACCOUNT_PATH=/etc/push/fcm_service_account.json

# APNs token-based auth (.p8) - opcional para dev
# APNS_KEY_PATH=/etc/push/apns_key.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=app.zaplivre.ios
# APNS_PRODUCTION=false

# Logging Level (optional)
RUST_LOG=zaplivre_push=info,info
